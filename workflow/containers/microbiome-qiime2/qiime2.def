Bootstrap: docker
From: mambaorg/micromamba:1.5.8

%post
    export MAMBA_ROOT_PREFIX=/opt/conda
    apt-get update -qq && apt-get install -y -q wget && rm -rf /var/lib/apt/lists/*
    wget -q https://data.qiime2.org/distro/amplicon/qiime2-amplicon-2023.9-py38-linux-conda.yml \
        -O /tmp/qiime2_env.yaml
    micromamba create -y -n qiime2 -f /tmp/qiime2_env.yaml
    test -x /opt/conda/envs/qiime2/bin/qiime
    micromamba clean -a -y

%environment
    export MAMBA_ROOT_PREFIX=/opt/conda
    export PATH=/opt/conda/envs/qiime2/bin:$PATH
    export CONDA_PREFIX=/opt/conda/envs/qiime2

%runscript
    exec "${@:-bash}"
